# AgentAuth Production Dockerfile
FROM python:3.11-slim

# Security: Run as non-root
RUN useradd -m -u 1000 agentauth

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir uvicorn[standard] asyncpg redis

# Copy application code
COPY core/ ./core/
COPY production_server.py .

# Security: Remove write permissions
RUN chown -R agentauth:agentauth /app

USER agentauth

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Run with multiple workers for production
CMD ["uvicorn", "production_server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
