# AgentAuth Production Dockerfile
FROM python:3.12-slim

# Security: Run as non-root
RUN useradd -m -u 1000 agentauth

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY core/ ./core/
COPY agentauth_core/ ./agentauth_core/
COPY alembic/ ./alembic/
COPY alembic.ini .
COPY production_server.py .

# Security: Remove write permissions
RUN chown -R agentauth:agentauth /app

USER agentauth

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Expose port
EXPOSE 8000

# Run Alembic migrations then start the server
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 4"]
