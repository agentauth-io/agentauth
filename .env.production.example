# AgentAuth Production Environment
# NEVER commit this file with real values!

# =============================================================================
# SECRETS (Required)
# =============================================================================

# Master secret for cryptographic operations (64 hex chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_SECRET=your_64_char_hex_master_secret_here

# Database password
DB_PASSWORD=strong_random_password_here

# =============================================================================
# Database
# =============================================================================

DATABASE_URL=postgresql://agentauth:${DB_PASSWORD}@postgres:5432/agentauth

# =============================================================================
# Redis
# =============================================================================

REDIS_URL=redis://redis:6379

# =============================================================================
# Application
# =============================================================================

ENVIRONMENT=production
DEBUG=false
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=2000

# =============================================================================
# Monitoring
# =============================================================================

GRAFANA_PASSWORD=secure_grafana_password
PGADMIN_EMAIL=admin@agentauth.in
PGADMIN_PASSWORD=secure_pgadmin_password

# =============================================================================
# External Services (Optional)
# =============================================================================

# Stripe (for payment processing)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Sentry (error tracking)
SENTRY_DSN=https://xxx@sentry.io/xxx

# AWS (for audit log backup)
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=agentauth-audit-logs

# =============================================================================
# TLS/SSL
# =============================================================================

# Path to SSL certificates (for nginx)
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
