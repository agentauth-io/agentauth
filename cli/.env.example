# AgentAuth CLI Environment Variables
# Copy this to .env and fill in your values

# AI Provider: openai, anthropic, groq, ollama
AGENTAUTH_AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=

# Anthropic (alternative)
# ANTHROPIC_API_KEY=

# Groq (alternative - fast, free tier)
# GROQ_API_KEY=

# Ollama (local, no key needed)
# OLLAMA_HOST=http://localhost:11434

# AgentAuth API (optional)
# AGENTAUTH_API_URL=https://api.agentauth.in
# AGENTAUTH_API_KEY=
